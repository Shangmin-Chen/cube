{
  "name": "cube",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync:algs": "node scripts/sync-algorithms.mjs",
    "verify:algs": "node scripts/verify-cfop.mjs && node scripts/verify-cross-cases.mjs",
    "verify:cross": "node scripts/verify-cross-cases.mjs",
    "verify:trainer": "node --experimental-strip-types scripts/verify-trainer-session.ts",
    "verify:triggers": "node --experimental-strip-types scripts/verify-triggers.ts",
    "verify:upstream-pin": "node scripts/verify-upstream-pin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cubing": "^0.63.4",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
